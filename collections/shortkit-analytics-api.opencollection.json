{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShortKit Ad Configuration Analytics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ingest Events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.shortkit.dev/v1/events",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Client-side event ingestion. Called automatically by the SDK using a publishable key."
        },
        {
          "info": {
            "name": "List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shortkit.dev/v1/events/explore",
            "params": [
              {
                "name": "event_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "content_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Events"
        },
        {
          "info": {
            "name": "Get Metric",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shortkit.dev/v1/metrics/:metric",
            "params": [
              {
                "name": "metric",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Metric"
        },
        {
          "info": {
            "name": "Get Metric Timeseries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shortkit.dev/v1/metrics/:metric/timeseries",
            "params": [
              {
                "name": "metric",
                "value": "",
                "type": "path"
              },
              {
                "name": "interval",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Metric Timeseries"
        }
      ]
    }
  ],
  "bundled": true
}