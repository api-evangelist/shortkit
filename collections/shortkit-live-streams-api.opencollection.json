          "info": {
            "name": "List Live Streams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shortkit.dev/v1/live-streams"
          },
          "docs": "List Live Streams"
        },
        {
          "info": {
            "name": "Create Live Stream",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.shortkit.dev/v1/live-streams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a ready-to-use RTMPS broadcast URL and stream key (shown once)."
        },
        {
          "info": {
            "name": "Get Live Stream Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shortkit.dev/v1/live-streams/status"
          },
          "docs": "Get Live Stream Status"
