{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShortKit Ad Configuration Live Streams API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Live Streams",
        "type": "folder"
      },
      "items": [
